@st.cache_data
def cargar_datos(archivo, sheet_name=0):
    # Lógica robusta de detección de encabezados (importada de Analisis.py)
    try:
        # 1. Leer primeras filas para detectar header
        archivo.seek(0)
        preview = pd.read_excel(archivo, sheet_name=sheet_name, header=None, nrows=20)
        
        keywords = ["RUT", "PROGRAMA", "NOMBRE", "ESTADO", "SIGLA", "NOTA", "CALIFICACION"]
        header_row_idx = 0
        max_hits = -1
        
        for i, row in preview.iterrows():
            row_str = [str(x).strip().upper() for x in row.values]
            
            # Skip filas que parecen filtros
            if any(x in ["(TODAS)", "(TODOS)"] for x in row_str):
                continue
                
            hits = sum(1 for k in keywords if any(k in s for s in row_str))
            
            # Priorizar filas con más aciertos
            if hits > max_hits and hits >= 1:
                max_hits = hits
                header_row_idx = i
        
        # 2. Cargar con el header correcto
        archivo.seek(0)
        df = pd.read_excel(archivo, sheet_name=sheet_name, header=header_row_idx)
        
    except Exception as e:
        # Fallback a lectura simple (CSV o Excel directo)
        archivo.seek(0)
        try:
            df = pd.read_excel(archivo, sheet_name=sheet_name)
        except:
            archivo.seek(0)
            df = pd.read_csv(archivo)
    
    # Normalización de nombres de columnas (upper + strip)
    df.columns = df.columns.astype(str).str.strip().str.upper()

    # Limpieza básica
    if 'RUT' in df.columns:
        df['RUT'] = df['RUT'].astype(str).str.strip()
    else:
        # Búsqueda difusa de RUT
        col_rut = next((c for c in df.columns if "RUT" in c), None)
        if col_rut:
            df = df.rename(columns={col_rut: 'RUT'})
            df['RUT'] = df['RUT'].astype(str).str.strip()
        else:
            st.error("❌ No se encontró la columna RUT en el archivo. Verifica el formato.")
            return pd.DataFrame()

    # Búsqueda robusta de PROGRAMA
    if 'PROGRAMA' not in df.columns:
        col_prog = next((c for c in df.columns if "PROGRAMA" in c or "CARRERA" in c), None)
        if col_prog:
            df = df.rename(columns={col_prog: 'PROGRAMA'})
        else:
            # Fallback crítico: Crear columna dummy para no romper la app, pero avisar
            st.warning("⚠️ No se encontró columna 'PROGRAMA'. Se usará 'GENERAL' por defecto.")
            df['PROGRAMA'] = "GENERAL"

    cols_identidad = ['RUT', 'A. PATERNO', 'A. MATERNO', 'NOMBRE', 'PROGRAMA']
    
    # Asegurar que existan las columnas (ajuste robusto)
    for c in cols_identidad:
        if c in df.columns:
            df[c] = df[c].ffill()

    # --- CREACIÓN DE NOMBRE COMPLETO ---
    # Intenta concatenar NOMBRE + A. PATERNO + A. MATERNO si existen
    if 'NOMBRE' in df.columns:
        df['NOMBRE_COMPLETO'] = df['NOMBRE'].astype(str).str.strip()
        
        # Buscar columnas de apellidos de forma flexible
        col_paterno = next((c for c in df.columns if "PATERNO" in c), None)
        col_materno = next((c for c in df.columns if "MATERNO" in c), None)
        
        if col_paterno:
            df['NOMBRE_COMPLETO'] += " " + df[col_paterno].astype(str).str.strip()
        if col_materno:
            df['NOMBRE_COMPLETO'] += " " + df[col_materno].astype(str).str.strip()
            
        df['NOMBRE_COMPLETO'] = df['NOMBRE_COMPLETO'].str.title()
    else:
        # Fallback si no hay columna NOMBRE explícita
        col_nombre_alt = next((c for c in df.columns if "ALUMNO" in c or "NOMBRE" in c), None)
        if col_nombre_alt:
            df['NOMBRE_COMPLETO'] = df[col_nombre_alt].astype(str).str.strip().str.title()
        else:
            df['NOMBRE_COMPLETO'] = "Estudiante Desconocido"

    # --- OPTIMIZACIÓN BUSCADOR (Pre-cálculo) ---
    # Creamos columnas limpias y label único aquí para evitar recalculo en cada interacción
    df['RUT_CLEAN'] = df['RUT'].astype(str).str.strip()
    # Filtro básico de basura
    df = df[df['RUT_CLEAN'].str.len() > 3] # RUTs muy cortos suelen ser basura
    
    # Crear SEARCH_LABEL único
    df['SEARCH_LABEL'] = df['RUT_CLEAN'] + " - " + df['NOMBRE_COMPLETO']
    
    return df

