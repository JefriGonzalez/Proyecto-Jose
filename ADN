                    df_calculo = df_alumno[~mask_ignorar]
                else:
                    # Si no hay estado, asumimos todo lo que tenga nota > 0
                    df_calculo = df_alumno
                
                # Filtro final de nota > 0 (por si hay reprobados con nota 0 o vacía)
                df_calculo = df_calculo[df_calculo['NOTA_VALOR'] > 0]
                
                # CÁLCULO FINAL (PROMEDIO SIMPLE)
                if not df_calculo.empty:
                    promedio_final = df_calculo['NOTA_VALOR'].mean()
                else:
                    promedio_final = 0.0

                # --- NUEVA TABLA: PROMEDIO PONDERADO (SOLICITUD) ---
                # Buscar columna de créditos
                col_creditos = next((c for c in df_alumno.columns if "CREDITOS" in c or "SCT" in c or "CR" in c), None)
                
                resumen_data = {
                    "Métrica": ["Promedio Simple (Notas > 0)"],
                    "Valor": [f"{promedio_final:.2f}"]
                }
                
                if col_creditos:
                    # Normalizar créditos a numérico
                    def limpiar_credito(x):
                        try:
                            val = float(str(x).replace(',', '.'))
                            return val if val > 0 else 0.0
                        except:
                            return 0.0
                    
                    # Usamos el mismo df_calculo (ya filtrado por Realizados y Nota > 0)
                    # Pero aseguramos que tenga la columna creditos limpia
                    # Ojo: df_calculo es un slice/copia de df_alumno
                    df_ponderado = df_calculo.copy()
                    df_ponderado['CREDITOS_VALOR'] = df_alumno.loc[df_ponderado.index, col_creditos].apply(limpiar_credito)
                    
                    numerador = (df_ponderado['NOTA_VALOR'] * df_ponderado['CREDITOS_VALOR']).sum()
                    denominador = df_ponderado['CREDITOS_VALOR'].sum()
                    
                    if denominador > 0:
                        promedio_pond = numerador / denominador
                        resumen_data["Métrica"].append("Promedio Ponderado")
                        resumen_data["Valor"].append(f"{promedio_pond:.2f}")
                    else:
                         resumen_data["Métrica"].append("Promedio Ponderado")
                         resumen_data["Valor"].append("N/A (Sin Créditos)")
                else:
                     # Si no hay columna creditos
                     resumen_data["Métrica"].append("Promedio Ponderado")
                     resumen_data["Valor"].append("N/A (Falta Columna Créditos)")

                # Mostrar Tabla Resumen
                df_resumen = pd.DataFrame(resumen_data)
                st.markdown("### 📊 Resumen Académico")
                st.dataframe(df_resumen, hide_index=True, use_container_width=True)

                # --- VISUALIZACIÓN (SÓLO GRÁFICO) ---
                # Gráfico de todas las notas (incluso pendientes si tienen nota) o solo cursadas?
                # Mostramos TODO el historial para contexto, coloreando por nota
                fig_tray = px.bar(df_alumno, x='SIGLA NODO', y='NOTA_VALOR',
                                  color='NOTA_VALOR',
                                  color_continuous_scale='RdYlGn',
                                  range_color=[1, 7],
                                  title="Trayectoria Académica Completa",
                                  labels={'NOTA_VALOR': 'Nota', 'SIGLA NODO': 'Asignatura'})
                
                fig_tray.add_hline(y=4.0, line_dash="dash", line_color="red", annotation_text="Aprobación")
                st.plotly_chart(fig_tray, use_container_width=True)
                
                st.divider()
                st.subheader("📋 Detalle de Asignaturas")
                
                # Seleccionar columnas para mostrar
                cols_display = ['SIGLA NODO', 'NOMBRE NODO', 'NOTA']
                if col_estado:
                    cols_display.append(col_estado)
                
                # Asegurar que existan
                cols_display = [c for c in cols_display if c in df_alumno.columns]
                
                st.dataframe(df_alumno[cols_display].drop_duplicates(), use_container_width=True)
            
            else:
                st.error("No se encontraron datos para el alumno seleccionado.")

else:
    st.info("👈 Por favor, carga tu archivo Excel o CSV en el menú lateral para comenzar.")
